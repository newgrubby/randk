# ============================================================
# RandK Center — переменные окружения
#
# Скопируйте в `.env.local` (разработка) или задайте на хостинге.
# ⚠️ `.env.local` не попадает в git.
# ============================================================


# --- Адрес сайта -------------------------------------------
# Используется для canonical, sitemap.xml, robots.txt и Open Graph.
# ОБЯЗАТЕЛЬНО задать перед production-сборкой, иначе ссылки будут
# вести на домен по умолчанию. Без завершающего слэша.
NEXT_PUBLIC_SITE_URL=https://randkcenter.ru


# --- Аналитика ---------------------------------------------
# ID счётчика Яндекс Метрики (только цифры, например 12345678).
# Если переменная пустая — счётчик НЕ загружается вообще:
# ни скрипта, ни cookie, ни запросов к внешним доменам.
NEXT_PUBLIC_YANDEX_METRIKA_ID=


# --- Режим сборки ------------------------------------------
# export     — статический сайт в папке out/ (по умолчанию).
#              Для обычного Linux-хостинга, Node.js на сервере не нужен.
# standalone — приложение Next.js для VPS или Node.js-хостинга.
#
# Обычно эту переменную задавать не нужно: `npm run build` собирает
# статику, `npm run build:standalone` — standalone.
# Подробности: docs/HOSTING_OPTIONS.md
# BUILD_TARGET=export


# ============================================================
# ЧЕГО ЗДЕСЬ НЕТ И ПОЧЕМУ
#
# Сайт не собирает заявки: форм, API-маршрутов и базы данных в проекте
# нет, персональные данные не обрабатываются. Поэтому не нужны
# TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID, SMTP и ключи CRM.
#
# Связь с центром идёт напрямую: телефоны офисов и сообщество VK
# задаются в src/content/centers.ts и src/content/site.ts.
# ============================================================
