# ============================================================
# RandK Center — переменные окружения
#
# Скопируйте этот файл в `.env.local` (для разработки)
# или задайте переменные на хостинге (для production).
#
# ⚠️ Файл `.env.local` НЕ попадает в git — не храните в нём то,
#    что нужно другим членам команды, и не коммитьте токены.
# ============================================================


# --- Адрес сайта -------------------------------------------
# Используется для canonical, sitemap.xml, robots.txt и Open Graph.
# ОБЯЗАТЕЛЬНО задать в production — иначе ссылки будут вести на дефолтный домен.
# Без завершающего слэша.
NEXT_PUBLIC_SITE_URL=https://randkcenter.ru


# --- Заявки: Telegram --------------------------------------
# Куда приходят заявки со всех форм сайта.
#
# Как получить:
#   1. TELEGRAM_BOT_TOKEN — напишите @BotFather в Telegram,
#      команда /newbot, скопируйте выданный токен.
#   2. TELEGRAM_CHAT_ID — добавьте бота в нужный чат (или напишите ему лично),
#      отправьте любое сообщение и откройте:
#      https://api.telegram.org/bot<ТОКЕН>/getUpdates
#      Нужное значение — result[0].message.chat.id
#      Для группы id отрицательный, например -1001234567890.
#
# Поведение, если переменные НЕ заданы:
#   • development — заявка печатается в консоль сервера, форма показывает успех;
#   • production  — форма показывает пользователю сообщение об ошибке (503),
#                   заявка НЕ сохраняется. Перед запуском обязательно настройте.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# --- Аналитика ---------------------------------------------
# ID счётчика Яндекс Метрики (только цифры, например 12345678).
# Если переменная пустая — счётчик НЕ загружается вообще.
NEXT_PUBLIC_YANDEX_METRIKA_ID=
